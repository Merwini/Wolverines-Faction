{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Blackwave (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Source/Blackwave/Blackwave.csproj",
        "--configuration",
        "Release",
        "--verbosity",
        "minimal"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
